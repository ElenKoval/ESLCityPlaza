NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Optional: needed to look up Auth emails and fully delete users from Approvals
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Your live site URL (Vercel), used for auth email redirects and the approval Log in link
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app
# Resend: notify Tech of a new confirmed application (not the user's confirmation email)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=ESL on the Plaza <hello@yourdomain.com>
# APPROVAL_NOTIFY_EMAIL=plazaenglishgroup@gmail.com
# Gmail SMTP: approval email to the new member (server-side only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=plazaenglishgroup@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=ESL on the Plaza <plazaenglishgroup@gmail.com>
# Keep only if you still want the private /enter Tech key fallback
# DEMO_ACCESS_KEY=plaza-elena
